{
    "name": "news-management-hub",
    "private": true,
    "version": "1.0.0",
    "scripts": {
        "dev": "npm run dev --prefix client",
        "server": "npm run start:dev --prefix server",
        "start": "concurrently \"npm run dev --prefix client\" \"npm run start:dev --prefix server\"",
        "build": "npm run build --prefix client",
        "prepare": "husky",
        "prettier": "prettier --write ."
    },
    "devDependencies": {
        "concurrently": "^9.1.2",
        "husky": "^9.1.7",
        "lint-staged": "^16.2.7",
        "prettier": "^3.8.1"
    },
    "lint-staged": {
        "**/*": "prettier --write --ignore-unknown"
    }
}
